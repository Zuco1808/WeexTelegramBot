# WEEX API kljucevi (Faza 3) - kopiraj u .env i popuni. .env je u .gitignore.
# NIKAD ne commitaj prave kljuceve.
WEEX_API_KEY=
WEEX_API_SECRET=
WEEX_API_PASSPHRASE=
# WEEX contract (futures) host; default je vec postavljen u kodu:
WEEX_BASE_URL=https://api-contract.weex.com

# Telegram ingest (Faza 3.6) - api_id/hash s https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNEL=@nazivkanala

